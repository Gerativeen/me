  <row>
    <key c="shift" indication="" width="1.2" ne="compose" sw="alt" />
    <key c="з" indication="Z" sw="ж" />
    <key c="ь" indication="" sw="ъ" />
    <key c="ц" indication="C" sw="ч" />
    <key c="в" indication="V" />
