<keyboard name="Gerativeens (CY)" script="cyrillic" bottom_row="false">



<modmap>
<ctrl a="a" b="selectAll" />
<ctrl a="z" b="undo" />
<ctrl a="x" b="cut" />
<ctrl a="c" b="copy" />
<ctrl a="v" b="paste" />
<ctrl a="y" b="redo" />

<fn a=":" b=":" />
<fn a="\t" b="tab" />
<fn a="*" b="×" />
<fn a="/" b="÷" />
<fn a="$" b="€" />
<fn a="•" b="★" />
<fn a="'" b="ˇ" />
<fn a="(" b="„" />
<fn a="+" b="±" />
<fn a="&quot;" b="&quot;" />
