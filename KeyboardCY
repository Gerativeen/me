  <row height="0.9">
    <key c="ctrl" width="1.7" se="switch_numeric" n="fn" />
    <key c="switch_emoji" width="1.1" s="config" n="switch_forward" />
    <key c="space" width="4.4" n="up" s="down" w="left" e="right" />
    <key c="&#0;" width="1.1" nw="nbsp" ne="nnbsp" />
		<key c="enter" width="1.7" ne="action" nw="\n" />
  </row>





