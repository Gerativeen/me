  <row>
    <key c="а" indication="A" shift="0.2" width="1.2" />
    <key c="с" indication="S" sw="ш" se="щ" />
    <key c="д" indication="D" />
    <key c="ф" indication="F" />
    <key c="г" indication="G" />
    <key c="х" indication="H" />
