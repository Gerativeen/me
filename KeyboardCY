  <key c="8" indication="" s="*" n="+" />
  <key c="9" indication="" s="(" n="=" />
  <key c="0" indication="" s=")" n="•" />
  </row>





  <row>
    <key c="" indication="" nw="esc" ne="`" se="superscript" />
    <key c="" indication="" se="subscript" />
    <key c="е" indication="E" />
    <key c="р" indication="R" />
    <key c="т" indication="T" />
    <key c="ы" indication="Y" />
    <key c="у" indication="U" />
    <key c="и" indication="I" sw="{" se="}" nw="ё"/>
    <key c="о" indication="O" />
    <key c="п" indication="P" sw="?" />
